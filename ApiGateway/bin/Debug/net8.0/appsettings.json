{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "externalservice": {
        "ClusterId": "externalcluster", 
        "Match": {
          "Path": "/external/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/external"
          }
        ]
      }
    },
    "Clusters": {
      "externalcluster": {
        "Destinations": {
          "externalapi": {
            "Address": "http://externalservice:2000/"
          }
        }
      }
    }
  }
}
